---
const athleteData = {
  label: "Triatleta",
  title: "La disciplina es mi ventaja competitiva",
  paragraphs: [
    "El deporte forma parte de mi identidad desde hace anos. No como un complemento, sino como una escuela constante de foco, autocontrol y rendimiento.",
    "Entrenar me enseno que la consistencia pesa mas que la motivacion puntual. Esa misma logica la aplico en cada proyecto: procesos claros, ejecucion sostenida y mejora continua.",
    "Cuando trabajo con marcas y negocios, llevo esa mentalidad al dia a dia: decisiones con criterio, ritmo de trabajo estable y orientacion real a resultados."
  ],
  quote: "La consistencia siempre supera la motivacion.",
  pillars: ["Resistencia", "Enfoque", "Disciplina"],
  cta: {
    label: "Ver servicios",
    href: "#servicios"
  }
};
---

<section class="section athlete-section" id="atleta" aria-labelledby="athlete-title">
  <div class="athlete-shape athlete-shape-a" aria-hidden="true"></div>
  <div class="athlete-shape athlete-shape-b" aria-hidden="true"></div>

  <div class="container athlete-grid">
    <figure class="athlete-media reveal-on-scroll" aria-hidden="true">
      <div class="athlete-media-shell" data-parallax>
        <div class="athlete-media-image">
          <img
            class="athlete-media-photo"
            src="/images/hero%20image.jpeg"
            alt="Triatleta en entrenamiento"
            loading="lazy"
            decoding="async"
          />
          <span class="athlete-media-glow"></span>
        </div>
      </div>
    </figure>

    <article class="athlete-copy reveal-on-scroll">
      <p class="athlete-label">
        <span class="athlete-label-line"></span>
        {athleteData.label}
      </p>

      <h2 id="athlete-title">{athleteData.title}</h2>

      <div class="athlete-story">
        {athleteData.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <blockquote class="athlete-quote">{athleteData.quote}</blockquote>

      <div class="athlete-points" role="list" aria-label="Fortalezas triatleta">
        {
          athleteData.pillars.map((item) => (
            <p role="listitem">
              <span class="dot" aria-hidden="true"></span>
              {item}
            </p>
          ))
        }
      </div>

      <a class="btn athlete-cta" href={athleteData.cta.href}>{athleteData.cta.label}</a>
    </article>
  </div>
</section>

<script>
  const athleteSection = document.querySelector(".athlete-section");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealItems = athleteSection?.querySelectorAll(".reveal-on-scroll");
  const parallaxNode = athleteSection?.querySelector("[data-parallax]");

  if (revealItems) {
    if (reduceMotion) {
      revealItems.forEach((node) => node.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.22 }
      );

      revealItems.forEach((node) => observer.observe(node));
    }
  }

  if (!reduceMotion && athleteSection && parallaxNode) {
    const updateParallax = () => {
      const rect = athleteSection.getBoundingClientRect();
      const windowHeight = window.innerHeight || 1;
      const centerDistance = rect.top + rect.height / 2 - windowHeight / 2;
      const normalized = Math.max(-1, Math.min(1, centerDistance / windowHeight));
      const offset = normalized * -8;

      parallaxNode.style.transform = `translate3d(0, ${offset}px, 0)`;
    };

    updateParallax();
    window.addEventListener("scroll", updateParallax, { passive: true });
  }
</script>

<style>
  .athlete-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f5f5f4 0%, #f8f7f5 100%);
  }

  .athlete-shape {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(68px);
    opacity: 0.3;
  }

  .athlete-shape-a {
    width: 260px;
    height: 260px;
    top: 60px;
    left: -120px;
    background: #ced9d6;
  }

  .athlete-shape-b {
    width: 320px;
    height: 320px;
    right: -150px;
    bottom: 20px;
    background: #e2d8ce;
  }

  .athlete-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.2rem;
    align-items: center;
  }

  .athlete-media,
  .athlete-copy {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.62s ease, transform 0.62s ease;
  }

  .athlete-media.is-visible,
  .athlete-copy.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .athlete-media {
    grid-column: 1 / span 12;
    order: 1;
    margin: 0;
  }

  .athlete-media-shell {
    transition: transform 0.2s linear;
  }

  .athlete-media-image {
    min-height: 360px;
    border-radius: 28px;
    border: 1px solid #ddd6cf;
    background: #ddd7d0;
    box-shadow: 0 14px 36px rgba(15, 15, 15, 0.08);
    position: relative;
    overflow: hidden;
  }

  .athlete-media-photo {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .athlete-media-glow {
    position: absolute;
    width: 210px;
    height: 210px;
    right: -30px;
    bottom: -30px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.38);
    filter: blur(20px);
  }

  .athlete-copy {
    grid-column: 1 / span 12;
    order: 2;
  }

  .athlete-label {
    margin: 0 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #66615d;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
  }

  .athlete-label-line {
    width: 1px;
    height: 14px;
    background: #8d8985;
  }

  .athlete-copy h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(1.95rem, 4.3vw, 3.8rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: #181817;
  }

  .athlete-story {
    margin-top: 1.2rem;
    max-width: 58ch;
    display: grid;
    gap: 0.72rem;
  }

  .athlete-story p {
    margin: 0;
    color: #615c58;
  }

  .athlete-quote {
    margin: 1.45rem 0 0;
    border-left: 1px solid #cbc4be;
    padding-left: 1rem;
    font-size: clamp(1.08rem, 2.3vw, 1.45rem);
    line-height: 1.38;
    color: #2b2927;
    max-width: 30ch;
  }

  .athlete-points {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .athlete-points p {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #ddd6cf;
    background: rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    padding: 0.36rem 0.75rem;
    color: #353332;
    font-size: 0.84rem;
  }

  .athlete-points .dot {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: #2f2d2b;
  }

  .athlete-cta {
    margin-top: 1.35rem;
    background: #fff;
    color: #1d1c1b;
    border: 1px solid #d8d1ca;
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .athlete-cta:hover {
    transform: translateY(-2px);
    border-color: #1d1c1b;
    box-shadow: 0 10px 26px rgba(14, 14, 14, 0.08);
  }

  @media (min-width: 960px) {
    .athlete-media {
      grid-column: 1 / span 6;
      order: 1;
    }

    .athlete-copy {
      grid-column: 7 / span 6;
      order: 2;
      padding-left: 0.4rem;
    }

    .athlete-media-image {
      min-height: 530px;
    }

    .athlete-media-photo {
      min-height: 530px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .athlete-media,
    .athlete-copy {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .athlete-media-shell,
    .athlete-cta,
    .athlete-cta:hover {
      transition: none;
      transform: none;
    }
  }
</style>
